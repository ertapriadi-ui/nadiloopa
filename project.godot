; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NADILOOPA"
config/description="Warm tropical portrait chain-puzzle game with smiling glossy organs, Nadi Loop, and Endpoint Pulse mechanics."
config/version="3.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.055, 0.255, 0.243, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/icons/launcher_192.png"
boot_splash/fullsize=false
config/icon="res://assets/icons/icon_1024.png"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

SaveManager="*res://scripts/autoload/save_manager.gd"
LocalizationManager="*res://scripts/autoload/localization_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
SubscriptionManager="*res://scripts/autoload/subscription_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=2400
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[internationalization]

locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=1
